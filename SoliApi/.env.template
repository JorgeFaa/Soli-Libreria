# =====================================================
# TEMPLATE DE VARIABLES DE ENTORNO - API SOLI V1 & V2
# =====================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como .env
# 2. Completa todos los valores
# 3. NO subas .env a Git (está en .gitignore)
#

# ============= BASE DE DATOS =============
# URL completa de conexión PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/tu_base_datos
# Usuario de la base de datos
DB_USER=tu_usuario
# Contraseña de la base de datos
DB_PASSWORD=tu_password

# ============= AWS CREDENTIALS =============
# Access Key ID de tu cuenta AWS
MY_AWS_ACCESS_KEY_ID=tu_access_key_id
# Secret Access Key de tu cuenta AWS
MY_AWS_SECRET_ACCESS_KEY=tu_secret_access_key

# ============= COGNITO OAUTH2 =============
# Región donde está tu Cognito User Pool
COGNITO_REGION=us-east-1
# ID de tu Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_lTSWlzRlA
# Client ID de la aplicación en Cognito
COGNITO_CLIENT_ID=tu_client_id
# Client Secret de la aplicación en Cognito
COGNITO_CLIENT_SECRET=tu_client_secret
# URL del JWK Set para validación de tokens
JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_lTSWlzRlA/.well-known/jwks.json

# ============= JWT & SECURITY =============
# Secreto para firmar tokens JWT (genera uno nuevo para producción)
JWT_SECRET=E3zYWBhYkzVcJjU/c7QQ1BVKqTRkXRqJVlgHaxtwqyY=

# ============= FRONTEND =============
# URL de tu frontend (para CORS y redirects)
FRONTEND_URL=https://d84l1y8p4kdic.cloudfront.net

# ============= SERVER CONFIGURATION =============
# Puerto del servidor (8080 por defecto, algunos servicios usan PORT)
PORT=8080