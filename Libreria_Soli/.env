# Configuración de API para AWS (Vite usa VITE_ como prefijo)
# Cambiar por tu URL real de API Gateway
VITE_API_BASE_URL=https://tu-api-gateway.execute-api.us-east-1.amazonaws.com/prod

# Timeout para las solicitudes (en milisegundos)
VITE_API_TIMEOUT=10000

# Nombre de la aplicación
VITE_APP_NAME=Soli Librería Digital
